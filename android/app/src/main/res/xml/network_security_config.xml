<?xml version="1.0" encoding="utf-8"?>
<!-- Les serveurs IPTV, décodeurs Enigma2 et portails MAG sont presque toujours en http simple -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
