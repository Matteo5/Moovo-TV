{
  "name": "moovo-tv",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "android:open": "npx cap open android",
    "android:apk:release": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Release",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:patch-ipa": "powershell -ExecutionPolicy Bypass -File scripts/patch-ipa.ps1",
    "desktop:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "desktop": "npm run build && npm run desktop:main && electron .",
    "desktop:exe": "npm run build && npm run desktop:main && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "hls.js": "^1.7.3",
    "iptv-playlist-parser": "^0.15.2",
    "lucide-react": "^1.56.0",
    "mux.js": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Moovo TV : chaînes en direct, guide TV, films et séries de votre abonnement IPTV",
  "author": "Moovo TV",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "tv.moovo.app",
    "productName": "Moovo TV",
    "copyright": "Moovo TV",
    "directories": {
      "output": "release/desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Moovo-TV-${version}-portable.exe"
    }
  }
}
